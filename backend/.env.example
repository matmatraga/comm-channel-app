PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/omnichannel
JWT_SECRET=your_jwt_secret
SESSION_SECRET=your_session_secret
CLIENT_URL=http://localhost:5173
# Production (comma-separated for local + deployed frontends):
# CLIENT_URL=https://comm-channel-app.vercel.app,http://localhost:5173
# Vercel preview URLs (e.g. comm-channel-xxx-team.vercel.app) are allowed automatically
# when CLIENT_URL includes a .vercel.app domain. Set to false to disable:
# ALLOW_VERCEL_PREVIEWS=false
API_URL=http://localhost:5000

# Gmail (shared demo inbox) — use App Password, NOT your Gmail login password
# Create at: Google Account → Security → 2-Step Verification → App passwords
# Paste without quotes; spaces are OK (stripped automatically)
FROM_EMAIL=your@gmail.com
FROM_PASSWORD=your_16_char_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Demo users (demo1@omnicomm.app, demo2@omnicomm.app) are seeded automatically on startup.
